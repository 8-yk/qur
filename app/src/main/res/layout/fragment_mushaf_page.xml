<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ورقة المصحف الكرتوني -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"
        android:orientation="vertical"
        android:background="@drawable/bg_mushaf_page_border">

        <!-- الشريط العلوي: الجزء | اسم السورة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp">

            <TextView
                android:id="@+id/tvJuzDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#9A8040"
                android:textSize="10sp"
                android:fontFamily="serif"
                android:gravity="end"
                android:letterSpacing="0.04"
                android:visibility="invisible" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="10dp"
                android:background="#7A6530"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/tvSurahCorner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#9A8040"
                android:textSize="10sp"
                android:fontFamily="serif"
                android:gravity="start"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- خط ذهبي رفيع فاصل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#7A6530"
            android:alpha="0.7" />

        <!-- رأس السورة المزخرف -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surah_header_band">

            <TextView
                android:id="@+id/tvMushafSurahHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/gold_primary"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:paddingVertical="13dp"
                android:paddingHorizontal="16dp"
                android:letterSpacing="0.08" />
        </FrameLayout>

        <!-- خط رفيع تحت الرأس -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#7A6530"
            android:alpha="0.5" />

        <!-- البسملة -->
        <TextView
            android:id="@+id/tvBismillah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
            android:gravity="center"
            android:textColor="@color/gold_primary"
            android:textSize="19sp"
            android:fontFamily="serif"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:visibility="gone" />

        <!-- خط رفيع تحت البسملة -->
        <View
            android:id="@+id/bismillahDivider"
            android:layout_width="90dp"
            android:layout_height="0.5dp"
            android:layout_gravity="center_horizontal"
            android:background="#C9A84C"
            android:alpha="0.4"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <!-- نص الآيات المتصل — يأخذ كامل المساحة -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdgeLength="20dp"
            android:requiresFadingEdge="vertical"
            android:scrollbarThumbVertical="@color/gold_dim"
            android:visibility="gone"
            android:id="@+id/svMushafContent">

            <TextView
                android:id="@+id/tvMushafContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:lineSpacingMultiplier="2.1"
                android:justificationMode="inter_word"
                android:paddingHorizontal="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="16dp" />
        </ScrollView>

        <!-- حالة فارغة -->
        <TextView
            android:id="@+id/tvMushafEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="﴿ لم يُضَف نص لهذه السورة ﴾\n\nاذهب إلى الإضافة لبناء بياناتك"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.8"
            android:visibility="gone" />

        <!-- خط ذهبي سفلي -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#7A6530"
            android:alpha="0.5" />

        <!-- رقم الصفحة في الأسفل -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvPageNumBottom"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/gold_primary"
                android:textSize="11sp"
                android:fontFamily="serif"
                android:background="@drawable/bg_page_num_mushaf" />
        </FrameLayout>

    </LinearLayout>

    <!-- مؤشر التحميل -->
    <ProgressBar
        android:id="@+id/mushafProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
