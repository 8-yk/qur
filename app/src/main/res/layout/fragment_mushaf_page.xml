<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#141020">

    <!-- ═══════════════════════════════════════════ -->
    <!-- رأس السورة — يُظهر فقط عند بداية كل سورة  -->
    <!-- ═══════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/surahHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <!-- الشريط الزخرفي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_surah_header_mushaf"
            android:paddingVertical="14dp"
            android:paddingHorizontal="16dp">

            <!-- زخرفة يمين -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="﴾"
                android:textColor="#C9A84C"
                android:textSize="22sp"
                android:fontFamily="serif" />

            <!-- اسم السورة -->
            <TextView
                android:id="@+id/tvMushafSurahHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#EAD080"
                android:textSize="19sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <!-- زخرفة يسار -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="﴿"
                android:textColor="#C9A84C"
                android:textSize="22sp"
                android:fontFamily="serif" />

        </LinearLayout>
    </FrameLayout>

    <!-- البسملة -->
    <TextView
        android:id="@+id/tvBismillah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"
        android:gravity="center"
        android:textColor="#C9A84C"
        android:textSize="22sp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- خط رفيع بعد البسملة -->
    <View
        android:id="@+id/bismillahDivider"
        android:layout_width="80dp"
        android:layout_height="0.5dp"
        android:layout_gravity="center_horizontal"
        android:background="#C9A84C"
        android:alpha="0.3"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- نص الآيات — المنطقة الرئيسية                -->
    <!-- ═══════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/svMushafContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdgeLength="18dp"
        android:requiresFadingEdge="vertical"
        android:overScrollMode="never"
        android:scrollbarThumbVertical="@color/gold_dim"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMushafContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#EBE5D0"
            android:textSize="22sp"
            android:lineSpacingMultiplier="2.0"
            android:gravity="center"
            android:textAlignment="center"
            android:letterSpacing="-0.02"

            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />
    </ScrollView>

    <!-- حالة فارغة -->
    <LinearLayout
        android:id="@+id/emptyContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="﴿ لم يُضَف نص لهذه السورة ﴾"
            android:textColor="#6A5520"
            android:textSize="16sp"
            android:fontFamily="serif"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="اذهب إلى الإضافة لبناء بياناتك"
            android:textColor="#404060"
            android:textSize="13sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════ -->
    <!-- رقم الصفحة في قاع الصفحة                   -->
    <!-- ═══════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp">

        <TextView
            android:id="@+id/tvPageNumBottom"
            android:layout_width="52dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="#9A8040"
            android:textSize="11sp"
            android:fontFamily="serif"
            android:background="@drawable/bg_page_num_oval" />
    </FrameLayout>

    <!-- مؤشر التحميل — خارج التدفق -->
    <ProgressBar
        android:id="@+id/mushafProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>
