<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- صفحات المصحف -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="84dp"
        android:paddingBottom="64dp"
        android:clipToPadding="false" />

    <!-- شريط علوي مبسّط -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:gravity="center_vertical"
            android:paddingTop="50dp"
            android:paddingBottom="10dp"
            android:paddingHorizontal="18dp">

            <!-- عنوان -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="المصحف"
                android:textColor="@color/gold_primary"
                android:textSize="18sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- زر الانتقال -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMushafJump"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="انتقل ›"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/gold_dim"
                android:textColor="@color/gold_primary"
                app:cornerRadius="17dp"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- شريط تقدم -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/mushafTopProgress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            app:trackCornerRadius="0dp"
            app:indicatorColor="@color/gold_primary"
            app:trackColor="@color/gold_track"
            android:progress="0" />

    </LinearLayout>

    <!-- شريط سفلي للتنقل -->
    <LinearLayout
        android:id="@+id/mushafBottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="center_vertical"
        android:background="@color/bg_surface"
        android:elevation="6dp"
        android:paddingHorizontal="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMushafPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ السابقة"
            android:textSize="13sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/gold_primary" />

        <TextView
            android:id="@+id/tvMushafPageNum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMushafNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="التالية ›"
            android:textSize="13sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/gold_primary" />

    </LinearLayout>

    <!-- حالة فارغة (لا توجد بيانات أبداً) -->
    <LinearLayout
        android:id="@+id/tvMushafEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="﴿ المصحف فارغ ﴾"
            android:textColor="@color/gold_dim"
            android:textSize="20sp"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="أضف سوراً وآيات أولاً من تبويب الإضافة"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
