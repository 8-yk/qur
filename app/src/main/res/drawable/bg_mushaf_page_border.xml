<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- خلفية الصفحة -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D1018" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- الإطار الذهبي الخارجي -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#C9A84C" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- الإطار الداخلي الرفيع -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#8A6C2C" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
